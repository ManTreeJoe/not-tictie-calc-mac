  "tickmarks": [
    { "symbol": "✓",   "meaning": "Verified / agreed",            "color": "green" },
    { "symbol": "F",   "meaning": "Footed (column adds)",         "color": "blue"  },
    { "symbol": "C",   "meaning": "Cross-footed",                 "color": "blue"  },
    { "symbol": "T",   "meaning": "Traced / tied to support",     "color": "green" },
