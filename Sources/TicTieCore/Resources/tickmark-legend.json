    { "symbol": "PY",  "meaning": "Per prior-year workpaper",     "color": "blue"  },
    { "symbol": "R",   "meaning": "Recomputed",                   "color": "green" },
    { "symbol": "N/A", "meaning": "Not applicable",               "color": "red"   },
